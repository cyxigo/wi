// $ok
obj_contact := object {
    email: "";
    phone: "";
};

obj_address := object {
    street: "";
    city: "";
};

obj_person := new obj_contact, obj_address {
    name: "";
    show_info: |self| => {
        std::puts("${self.name} lives in ${self.city}, email: ${self.email}");
    };
};

alice := new obj_person {
    name: "Alice";
    email: "alice@work.com";
    city: "New York";
};

alice->show_info();
