// $ok
// simple
factorial := |n| => {
    if (n <= 1) {
        return 1;
    }

    return n * factorial(n - 1);
};

std::puts(factorial(5));

// tco
count := |n| => {
    if (n == 0) {
        return 0;
    }

    return count(n - 1);
};

// should pass and not obliterate the stack because of the tco
std::puts(count(5000000));
