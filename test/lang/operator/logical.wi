// $ok
std::puts(true && false);
std::puts(true && true);
std::puts(false && true);
std::puts(false && false);

std::puts(true || false);
std::puts(true || true);
std::puts(false || true);
std::puts(false || false);

std::puts(!true);
std::puts(!false);
std::puts(!0);
std::puts(!1);

std::puts(!(10 == 10));
std::puts(!(10 != 10));
std::puts((1 > 2) && (2 >= 2));
std::puts((1 < 2) || (2 <= 2));
