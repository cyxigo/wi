var obj_toggle = object {
    state = false;
    value = |self| => {
        return self.state;
    };
    activate = |self| => {
        self.state = !self.state;
        return self;
    };
};w

var new_toggle = |start_state| => {
    return new obj_toggle { 
        state = start_state; 
    };
};  

var obj_nth_toggle = new obj_toggle {
    count_max = 0;
    count = 0;
    activate = |self| => {
        self.count = self.count + 1;

        if (self.count >= self.count_max) {
            obj_toggle.activate(self);
            self.count = 0;
        }

        return self;
    };
};

var new_nth_toggle = |start_state, max_counter| => {
    return new obj_nth_toggle {
        state = start_state;
        count_max = max_counter;
    };
};

var main = || => {
    var start = os.clock();
    var n = 100000;
    var val = true;
    var t = new_toggle(val);

    for (var i = 0; i < n; i = i + 1) {
        val = t->activate()->value();
        val = t->activate()->value();
        val = t->activate()->value();
        val = t->activate()->value();
        val = t->activate()->value();
        val = t->activate()->value();
        val = t->activate()->value();
        val = t->activate()->value();
        val = t->activate()->value();
        val = t->activate()->value();
    }

    print(t->value());
    var nt = new_nth_toggle(val, 3);

    for (var i = 0; i < n; i = i + 1) {
        val = nt->activate()->value();
        val = nt->activate()->value();
        val = nt->activate()->value();
        val = nt->activate()->value();
        val = nt->activate()->value();
        val = nt->activate()->value();
        val = nt->activate()->value();
        val = nt->activate()->value();
        val = nt->activate()->value();
        val = nt->activate()->value();
    }

    print(nt->value());
    print("elapsed: " .. os.clock() - start);
};

main();
