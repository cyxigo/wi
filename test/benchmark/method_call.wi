main := || => {
    start := os.clock();
    n := 100000;
    val := true;
    t := object {
        state: val;
        value: |self| => {
            return self.state;
        };
        activate: |self| => {
            self.state = !self.state;
            return self;
        };
    };

    for (i := 0; i < n; i = i + 1) {
        val = t->activate()->value();
        val = t->activate()->value();
        val = t->activate()->value();
        val = t->activate()->value();
        val = t->activate()->value();
        val = t->activate()->value();
        val = t->activate()->value();
        val = t->activate()->value();
        val = t->activate()->value();
        val = t->activate()->value();
    }

    print(t->value());
    nt := new t {
        state: val;
        count_max: 3;
        count: 0;
        activate: |self| => {
            self.count = self.count + 1;

            if (self.count >= self.count_max) {
                t.activate(self);
                self.count = 0;
            }

            return self;
        };
    };

    for (i := 0; i < n; i = i + 1) {
        val = nt->activate()->value();
        val = nt->activate()->value();
        val = nt->activate()->value();
        val = nt->activate()->value();
        val = nt->activate()->value();
        val = nt->activate()->value();
        val = nt->activate()->value();
        val = nt->activate()->value();
        val = nt->activate()->value();
        val = nt->activate()->value();
    }

    print(nt->value());
    print("elapsed ${os.clock() - start}");
};

main();
