bottom_up_tree := |item, depth| => {
    if (depth > 0) {
        i := item + item;
        depth = depth - 1;
        left := bottom_up_tree(i - 1, depth);
        right := bottom_up_tree(i, depth);
        return [item, left, right];
    }
    
    return [item];
};

item_check := |tree| => {
    if (#tree > 1) {
        return tree[0] + item_check(tree[1]) - item_check(tree[2]);
    }
    
    return tree[0];
};

n :=  12;
min_depth := 4;
max_depth := min_depth + 2;

if (max_depth < n) {
    max_depth = n;
}

start := os.clock();

{
    stretch_depth := max_depth + 1;
    stretch_tree := bottom_up_tree(0, stretch_depth);
    puts("stretch tree of depth ${stretch_depth} check: ${item_check(stretch_tree)}");
}

long_lived_tree := bottom_up_tree(0, max_depth);

for (depth := min_depth; depth <= max_depth; depth = depth + 2) {
    iterations := 2 ** (max_depth - depth + min_depth);
    check := 0;
    
    for (i := 1; i <= iterations; i = i + 1) {
        check = check + item_check(bottom_up_tree(1, depth)) + 
                item_check(bottom_up_tree(-1, depth));
    }

    puts("${iterations * 2} trees of depth ${depth} check: ${check}");
}

puts("long lived tree of depth ${max_depth} check: ${item_check(long_lived_tree)}");
puts("elapsed: ${os.clock() - start}");
