        BLOCK "040904B0" {
            VALUE "CompanyName", "cyxigo"
            VALUE "FileDescription", "Wi Programming Language" 
            VALUE "FileVersion", "8.1.0-beta"
            VALUE "InternalName", "wi"
            VALUE "LegalCopyright", "Copyright (C) 2026 cyxigo"
            VALUE "OriginalFilename", "wi.exe"
            VALUE "ProductName", "Wi"
            VALUE "ProductVersion", "8.1.0-beta"
        }
    }
    BLOCK "VarFileInfo" {
        VALUE "Translation", 0x0409, 1200
    }
}
